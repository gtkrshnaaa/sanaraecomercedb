# ==============================================================================
# Sanara E-Commerce Dedicated MySQL 8.0 Production Configuration
# Tailored for High-Throughput Digital Products & Visual Communication Assets
# ==============================================================================

[mysqld]
# --- Network & Remote Connectivity ---
user                            = mysql
pid-file                        = /var/run/mysqld/mysqld.pid
socket                          = /var/run/mysqld/mysqld.sock
port                            = 3306
datadir                         = /var/lib/mysql
tmpdir                          = /tmp
bind-address                    = 0.0.0.0
mysqlx-bind-address             = 0.0.0.0
skip-name-resolve               = 1
max_connections                 = 500
max_connect_errors              = 10000
connect_timeout                 = 10
wait_timeout                    = 600
interactive_timeout             = 600
back_log                        = 512

# --- Storage Engine & Memory Optimization (InnoDB) ---
default_storage_engine          = InnoDB
innodb_buffer_pool_size         = 4G
innodb_buffer_pool_instances    = 4
innodb_redo_log_capacity        = 2G
innodb_flush_log_at_trx_commit  = 1
innodb_flush_method             = O_DIRECT
innodb_file_per_table           = 1
innodb_stats_on_metadata        = 0
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8
innodb_io_capacity              = 2000
innodb_io_capacity_max          = 4000
innodb_autoinc_lock_mode        = 2
innodb_open_files               = 4096

# --- Threading & Concurrency ---
thread_cache_size               = 64
thread_stack                    = 256K
table_open_cache                = 4096
table_definition_cache          = 2048
open_files_limit                = 65535

# --- Buffer & Temporary Table Limits ---
sort_buffer_size                = 4M
read_buffer_size                = 2M
read_rnd_buffer_size            = 4M
join_buffer_size                = 4M
tmp_table_size                  = 128M
max_heap_table_size             = 128M

# --- Character Sets & Collations ---
character-set-server            = utf8mb4
collation-server                = utf8mb4_0900_ai_ci

# --- Logging & Telemetry ---
log_error                       = /var/log/mysql/error.log
log_error_verbosity             = 2
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/mysql-slow.log
long_query_time                 = 1.000000
log_queries_not_using_indexes   = 0
min_examined_row_limit          = 100

# --- Binary Logging & GTID Replication Readiness ---
server-id                       = 101
log_bin                         = /var/log/mysql/mysql-bin.log
binlog_format                   = ROW
binlog_expire_logs_seconds      = 604800
binlog_row_image                = FULL
gtid_mode                       = ON
enforce_gtid_consistency        = ON
log_replica_updates             = ON

# --- Security & SQL Modes ---
sql_mode                        = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
local_infile                    = 0
symbolic-links                  = 0
default_authentication_plugin   = caching_sha2_password

[client]
port                            = 3306
socket                          = /var/run/mysqld/mysqld.sock
default-character-set           = utf8mb4

[mysql]
default-character-set           = utf8mb4
